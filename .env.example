# Skopiuj ten plik jako .env.local i uzupełnij wartości

# Publiczny adres bazowy strony (bez trailing slash)
# Lokalnie: http://localhost:3000
# Produkcja: https://twoja-domena.pl
NEXT_PUBLIC_BASE_URL=https://sincore.io

# Token GitHuba (tylko odczyt publicznych repo). Bez niego API GitHuba przepuszcza
# 60 zapytań na godzinę z jednego IP i badge "do pobrania" znika przy przekroczeniu.
GITHUB_TOKEN=

# Bramka pobierania APK aplikacji Termopary ITS-90
TERMOPARY_DOWNLOAD_PASSWORD=
TERMOPARY_APK_URL=
